{
  "version": 2,
  "builds": [
    {
      "src": "src/play_human_vs_bot_flask.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/play_human_vs_bot_flask.py"
    }
  ],
  "functions": {
    "src/play_human_vs_bot_flask.py": {
      "maxDuration": 60
    }
  }
}
